# Gerçek değerleri kendi .env dosyanıza yazın; bu dosya örnektir.
PORT=3000
NODE_ENV=development
JWT_SECRET=BURAYA_EN_AZ_32_KARAKTER_RASTGELE_ANAHTAR
ENCRYPTION_KEY=BURAYA_64_HEX_KARAKTER
DPU_BASE_URL=https://DPU_BASE_ADRESINIZ
DPU_PROJECT_CODE=
DPU_API_KEY=
DPU_USER_EMAIL=
DPU_USER_PASSWORD=
OPENAI_API_KEY=
GEMINI_API_KEY=

# ─── KAPASİTE (küçük sunucu için güvenli varsayılanlar) ───
# Aynı anda koşan test sayısı. Her test ≈ 0,7-1 GB RAM + ≈ 0,5-1 çekirdek kullanır; fazlası sırada bekler.
# Kural: APP_MEM_LIMIT ≈ 1 GB + RUN_CONCURRENCY × 1 GB ; APP_CPUS ≈ RUN_CONCURRENCY
RUN_CONCURRENCY=2
APP_MEM_LIMIT=3g
APP_CPUS=2.0
SHM_SIZE=1gb
# Toplam kuyruk sınırı ve kullanıcı başına (sırada + çalışan) sınır
MAX_QUEUED_RUNS=200
MAX_QUEUED_PER_USER=50
# Aynı anda açık "tarayıcıdan kayıt" oturumu (kullanıcı başına 1; her biri bir Chromium'dur)
RECORD_MAX=2

# ─── YAPAY ZEKA (çeviri) KOTA KORUMASI ───
# Aynı anda çalışan çeviri sayısı, dakikadaki en fazla çeviri isteği ve sıradaki isteğin bekleme süresi.
# Gemini ücretsiz katman ≈ 10 istek/dk civarındadır -> AI_TRANSLATE_RPM=8 yapın.
# Ücretli katmanda (OpenAI/Gemini Tier 1 ≈ yüzlerce istek/dk) 60-120'ye çıkarabilirsiniz.
AI_CONCURRENCY=3
AI_TRANSLATE_RPM=20
AI_QUEUE_WAIT_MS=40000

# ─── GİRİŞ KORUMASI ───
# Hatalı giriş kullanıcı adı başına sayılır (NAT arkasındaki kullanıcılar birbirini kilitlemez).
LOGIN_MAX_FAILS_PER_USER=8
LOGIN_MAX_PER_IP=300

# ─── TEST HEDEFLERİ ───
# Asıl izinli adres listesi YÖNETİCİ PANELİNDEDİR: Ayarlar > "Test İzinli Adresler".
# Liste boşsa hiçbir test hedefi kabul edilmez. Aşağıdaki iki değişken isteğe bağlıdır ve listeye EK olarak eklenir.
ALLOWED_TEST_HOSTS=
# İç ağ (özel IP) adresine çözülmesine izin verilen host'lar (loopback/metadata her zaman engelli):
ALLOWED_PRIVATE_HOSTS=
ALLOWED_TEST_PORTS=80,443

# Seçici önbelleği: yapay zekanın bulduğu elemanlar saklanır, sonraki koşularda doğrulanıp yapay zekasız kullanılır.
# Sorun yaşarsanız off yapın veya panelden "Önbelleği Temizle"yi kullanın.
SELECTOR_CACHE=on

# Bir testin süre sınırı: boşsa adım sayısına göre otomatik = max(5 dk, 90 sn + 30 sn x adım), en çok 30 dk.
# Sabit değer (saniye) vermek için doldurun (en çok 7200).
RUN_TIMEOUT_SECONDS=
# Tek bir yapay zeka çağrısı bu süre içinde yanıt vermezse (sağlayıcı gecikmesi) aynı soru yeniden sorulur (sn).
AI_CALL_TIMEOUT_SECONDS=25

# Kapatma sırasında çalışan testlerin bitmesi için beklenecek süre (sn)
SHUTDOWN_GRACE_SECONDS=90
# CHROME_PATH yalnızca sistem Chromium yolu kullanacaksanız tanımlanır.

# Rapor detayında gösterilen yapay zeka yorumu (yalnızca tavsiye; test durumunu DEĞİŞTİRMEZ).
# Çeviri sağlayıcısını kullanır (her rapor için 1 kısa istek). Acil kapatma: off
AI_REPORT_ANALYSIS=on

# Tıklama gibi eylemler ağ isteği başlatırsa (ör. giriş) istekler bitene kadar en çok bu kadar beklenir (sn; 0 = kapalı).
AI_POST_ACTION_WAIT_SECONDS=8

# "Bul" (Find) adımlarında elemanın görünmesi için en çok beklenecek süre (sn; yavaş sayfalar için).
AI_FIND_WAIT_SECONDS=5
