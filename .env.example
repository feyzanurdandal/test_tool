PORT=3000

# ─── DPU BASE BAĞLANTI AYARLARI ───
DPU_BASE_URL=https://dpubase.dpu.edu.tr
DPU_PROJECT_CODE=test_otomasyonu
DPU_USER_EMAIL=user+test_otomasyonu@base.dpu.edu.tr

# Aşağıdaki alanlara kendi gizli anahtar/şifrelerinizi girin
DPU_API_KEY=your_dpu_api_key_here
DPU_USER_PASSWORD=your_dpu_user_password_here

# ─── BACKEND GÜVENLİK ───
JWT_SECRET=your_jwt_secret_key_here
# AES-256-GCM Şifreleme Anahtarı (Tam 32 Karakter / Hex olmalı)
#encryption key için terminalde 
#        node -e "console.log(require('crypto').randomBytes(32).toString('hex'))" 
#yazıyoruz çıkan değeri buraya koyuyoruz
ENCRYPTION_KEY=encryption_key

# ─── TEST ÇALIŞTIRMA KUYRUĞU ───
# Aynı anda koşabilecek test sayısı. Playwright HTML raporu ortak klasöre yazıldığı
# için 1 önerilir; artırırsanız sunucu kaynaklarını da göz önünde bulundurun.
RUN_CONCURRENCY=1
# Kuyrukta bekleyebilecek en fazla test sayısı
MAX_QUEUED_RUNS=50

# ─── AĞ GÜVENLİĞİ ───
# Testlerin iç ağ adreslerine gitmesi varsayılan olarak engellidir.
# Bilinçli olarak test edilecek iç ağ host'ları varsa virgülle yazın.
ALLOWED_PRIVATE_HOSTS=

# ─── OTURUM ÇEREZİ ───
# HTTPS arkasında çalışırken nginx X-Forwarded-Proto gönderdiği için çerez
# otomatik olarak "Secure" işaretlenir. Farklı bir proxy kullanıyorsanız true yapın.
COOKIE_SECURE=false
NODE_ENV=production
