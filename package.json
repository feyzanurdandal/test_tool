{
  "name": "test-tool",
  "version": "1.0.0",
  "description": "AI destekli Playwright test otomasyon platformu",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "build:css": "tailwindcss -i styles/tailwind.css -o public/css/app.css --minify",
    "watch:css": "tailwindcss -i styles/tailwind.css -o public/css/app.css --watch",
    "test": "node --test \"unit-tests/**/*.test.js\"",
    "test:ai-local": "playwright test tests/ai-security.spec.ts"
  },
  "keywords": [],
