    "playwright-lighthouse": "^4.0.0",
    "tailwindcss": "3.4.19"
  },
  "dependencies": {
    "@browserbasehq/stagehand": "^3.6.0",
    "@google/generative-ai": "^0.24.1",
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "node-fetch": "^3.3.2",
    "openai": "^6.47.0",
